[Unit]
Description=Departure board on an HDMI screen
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=departureboard
Group=departureboard
# video and render for the screen (KMS/DRM). Not input: that group can read
# every attached keyboard, and the board only drains SDL's event queue. Touch
# support would need it back.
SupplementaryGroups=video render
StateDirectory=departureboard
StateDirectoryMode=0750
EnvironmentFile=/etc/departureboard/secrets.env
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=/opt/departureboard/venv/bin/departureboard run --loop --config /etc/departureboard/config.toml
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No PrivateDevices: the board needs /dev/dri for the screen.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# No AF_NETLINK: SDL would use it only to watch for input devices being
# plugged in, which it can't open without the input group; video doesn't need it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
MemoryMax=256M

[Install]
WantedBy=multi-user.target
