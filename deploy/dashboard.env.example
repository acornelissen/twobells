# Keys for the dashboard container. Copy to dashboard.env next to docker-compose.yml.
# Rail Data Marketplace, Live Departure Board product: the consumer key.
RDM_API_KEY=
# Bus Open Data Service: the API key from your account settings.
BODS_API_KEY=
# Optional: Rail Data Marketplace, Service Details product: its own consumer key.
# With it, the dashboard shows where each of the next few trains is.
RDM_DETAILS_API_KEY=
# Optional: Rail Data Marketplace, Knowledgebase Incidents product: its own consumer key.
# With it (and [dashboard] kb_incidents_url set), the dashboard lists engineering works.
RDM_KB_API_KEY=
