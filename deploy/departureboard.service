[Unit]
Description=Inky pHAT departure board tick
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=departureboard
Group=departureboard
SupplementaryGroups=spi gpio i2c
StateDirectory=departureboard
StateDirectoryMode=0750
EnvironmentFile=/etc/departureboard/secrets.env
ExecStart=/opt/departureboard/venv/bin/departureboard run --config /etc/departureboard/config.toml
# A colour refresh takes about 20 s on the Zero W.
TimeoutStartSec=120
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No PrivateDevices: the board needs the SPI, GPIO and I2C devices.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
MemoryMax=256M
