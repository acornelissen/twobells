# Copy to /etc/departureboard/secrets.env and chmod 600.
# Rail Data Marketplace: consumer key for the "Live Departure Board" product.
RDM_API_KEY=
# TransportAPI: app_id and app_key from your app's credentials page.
TAPI_APP_ID=
TAPI_APP_KEY=
# Bus Open Data Service: API key from your BODS account settings. Only needed
# for the bus position page on an HDMI screen ([bus.routes] in config.toml).
BODS_API_KEY=
