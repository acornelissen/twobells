# The keys, for a Pi and for Docker. Keep the copy readable by you only.
#   Pi:     copy to /etc/twobells/secrets.env and chmod 600.
#   Docker: copy to secrets.env next to docker-compose.yml.
# Keys pasted in the settings site are saved in the store instead
# (/var/lib/twobells on a Pi, the twobells-data volume in Docker), and
# win over the ones here. Leave out what you don't use. See docs/keys.md.

# General: trains and buses, for the board and the dashboard.
# Rail Data Marketplace: the consumer key for the "Live Departure Board" product.
RDM_API_KEY=
# Bus Open Data Service: the API key from your BODS account settings. Needed for
# bus times from the BODS timetable ([bus] source = "bods"), for the dashboard's
# buses and bus disruptions, and for the bus position page on an HDMI screen
# ([bus.routes]).
BODS_API_KEY=

# Board: only for a board whose bus times come from TransportAPI. The
# app_id and app_key from your app's credentials page. The dashboard never
# uses them.
TAPI_APP_ID=
TAPI_APP_KEY=

# Dashboard: optional extras, each a Rail Data Marketplace product of its own.
# Service Details: where each of the next few trains is (on an HDMI screen's rows too),
# and Delay Repay on the Performance page, with a filter station (filter_crs).
RDM_DETAILS_API_KEY=
# Knowledgebase Incidents: engineering works, with the Knowledgebase Incidents
# address set (on the settings site's Keys tab, or [dashboard] kb_incidents_url).
RDM_KB_API_KEY=
