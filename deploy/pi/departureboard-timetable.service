[Unit]
Description=Departure board: build the BODS bus timetable if due
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=departureboard
Group=departureboard
StateDirectory=departureboard
StateDirectoryMode=0750
EnvironmentFile=/etc/departureboard/secrets.env
ExecStart=/opt/departureboard/venv/bin/departureboard timetable --install pi --config /etc/departureboard/config.toml
# Downloading and reading the operators' timetables takes minutes on a Zero W;
# the board's own tick comes first.
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
PrivateIPC=yes
ProtectClock=yes
ProcSubset=pid
MemoryMax=256M
