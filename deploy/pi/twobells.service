[Unit]
Description=Two Bells tick (Inky or Waveshare e-paper)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=twobells
Group=twobells
SupplementaryGroups=spi gpio i2c
StateDirectory=twobells
StateDirectoryMode=0750
# In memory, kept between runs until the Pi restarts (board/runfolder.py):
# which sources each run has fetched since the Pi started, so departures saved
# before it aren't taken for new (board/sinceboot.py); and while the state
# can't be saved (a full or read-only SD card), the last redraw, so the next
# run doesn't draw the panel again (board/unsaved.py).
RuntimeDirectory=twobells
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
EnvironmentFile=/etc/twobells/secrets.env
ExecStart=/opt/twobells/venv/bin/twobells run --config /etc/twobells/config.toml
# A colour refresh takes about 20 s on the Zero W.
TimeoutStartSec=120
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No PrivateDevices: the board needs the SPI, GPIO and I2C devices.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: not yet tried with the panels' drivers (inky,
# lgpio, spidev) and numpy on a Pi.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
PrivateIPC=yes
# No ProtectClock: it allows only the clock's devices, not SPI, GPIO and I2C.
# No ProcSubset=pid: the panels' drivers read /proc/cpuinfo and /proc/device-tree
# to tell which Pi this is. Other users' processes are hidden all the same.
ProtectProc=invisible
MemoryMax=256M
# A tick's threads, and those of the GPIO libraries and numpy, with room to spare.
TasksMax=64
