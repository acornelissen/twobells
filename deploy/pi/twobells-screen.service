[Unit]
Description=Two Bells on an HDMI screen
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=twobells
Group=twobells
# video and render for the screen (KMS/DRM). Not input: that group can read
# every attached keyboard, and the board only drains SDL's event queue. Touch
# support would need it back.
SupplementaryGroups=video render
StateDirectory=twobells
StateDirectoryMode=0750
EnvironmentFile=/etc/twobells/secrets.env
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=/opt/twobells/venv/bin/twobells run --loop --config /etc/twobells/config.toml
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No PrivateDevices: the board needs /dev/dri for the screen.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# No AF_NETLINK: SDL would use it only to watch for input devices being
# plugged in, which it can't open without the input group; video doesn't need it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
PrivateIPC=yes
# No ProtectClock: it allows only the clock's devices, and the screen needs /dev/dri.
ProcSubset=pid
MemoryMax=256M

[Install]
WantedBy=multi-user.target
