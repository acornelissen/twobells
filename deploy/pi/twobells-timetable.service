[Unit]
Description=Two Bells: build the BODS bus timetable and the Metrolink tram timetable if due
Wants=network-online.target
After=network-online.target
# Started by the timer and by twobells-timetable.path on each settings save,
# which come in runs; a build that fails exits 1. A start limit would fail
# the .path unit, and the timer with it.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=twobells
Group=twobells
StateDirectory=twobells
StateDirectoryMode=0750
EnvironmentFile=/etc/twobells/secrets.env
ExecStart=/opt/twobells/venv/bin/twobells timetable --install pi --config /etc/twobells/config.toml
# Downloading and reading the operators' timetables takes minutes on a Zero W;
# the board's own tick comes first.
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
PrivateIPC=yes
ProtectClock=yes
ProcSubset=pid
MemoryMax=256M
